# Copy to .env. Keys stay on the server. Choose ONE model provider + Tavily.
OPENAI_API_KEY=
TAVILY_API_KEY=

# OpenAI default: Responses API with function calls + reasoning.effort=low.
OPENAI_MODEL=gpt-5.4
# Gemini alternative: set CHAT_MODEL=gemini-2.5-flash and GOOGLE_API_KEY.
# CHAT_MODEL takes precedence over OPENAI_MODEL. No OpenAI key needed for Gemini.
CHAT_MODEL=
GOOGLE_API_KEY=
# AgentRouter alternative: MODEL_PROVIDER=agentrouter, AGENTROUTER_API_KEY,
# and a model supported by your AgentRouter account (CHAT_MODEL).
MODEL_PROVIDER=openai
AGENTROUTER_API_KEY=
# Optional Responses-compatible endpoint. AgentRouter defaults to its .org API.
OPENAI_BASE_URL=
# Optional protocol override: responses or chat. AgentRouter defaults to chat.
MODEL_API=
PORT=3000
# Local only by default. Read docs/OPERATIONS.md before exposing publicly.
HOST=127.0.0.1
DATABASE_PATH=./data/agent.sqlite
# Optional externally served origin. Authentication is required before public deployment.
PUBLIC_ORIGIN=
