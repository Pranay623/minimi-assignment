# Copy to .env. Keys stay on the server. Both are required for live chat.
OPENAI_API_KEY=
TAVILY_API_KEY=

# Any Responses API model supporting function calls and reasoning.effort=low.
OPENAI_MODEL=gpt-5.4
PORT=3000
# Local only by default. Read docs/OPERATIONS.md before exposing publicly.
HOST=127.0.0.1
DATABASE_PATH=./data/agent.sqlite
